SECMIND_ENV=development
SECMIND_API_PORT=8001
SECMIND_DEMO_MODE=true
SECMIND_DATABASE_URL=sqlite:///./data/secmind.db
SECMIND_INPUT_ROOT=./data/inputs
SECMIND_RUN_ROOT=./data/runs
SECMIND_UPLOAD_ROOT=./data/uploads
SECMIND_EVALUATION_ROOT=./data/evaluations
# Test3.0 local single-task evaluation (keep the private root inaccessible to the Agent/frontend)
SECMIND_BENCHMARK_DATASET_ROOT=
SECMIND_BENCHMARK_PRIVATE_ROOT=
SECMIND_BENCHMARK_SCORER_ROOT=
SECMIND_BENCHMARK_PYTHON_EXECUTABLE=python
SECMIND_BENCHMARK_DATASET_VERSION=3.0.0-2026.07
SECMIND_BENCHMARK_CANDIDATE_ID=secmind-v0.8.3-frontend-optimized
SECMIND_BENCHMARK_CANDIDATE_VERSION=0.8.3
SECMIND_BENCHMARK_DASHBOARD_URL=http://127.0.0.1:3001/
SECMIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SECMIND_QWEN_API_KEY=
SECMIND_REVERSE_BASE_URL=http://127.0.0.1:8002
SECMIND_CAIRN_BASE_URL=http://127.0.0.1:8000
SECMIND_MODULE_TIMEOUT_SECONDS=20
SECMIND_PLANNER_MODEL=qwen-plus
SECMIND_WORKER_MODEL=qwen-turbo
SECMIND_FALLBACK_MODEL=qwen-max
SECMIND_EMBEDDING_MODEL=text-embedding-v3
SECMIND_QDRANT_URL=http://qdrant:6333
SECMIND_QDRANT_COLLECTION=secmind_knowledge
SECMIND_MAX_STEPS=12
SECMIND_MAX_TOOL_CALLS=12
SECMIND_MAX_MODEL_CALLS=20
SECMIND_MAX_RUNTIME_SECONDS=600
SECMIND_MAX_UPLOAD_BYTES=52428800
SECMIND_MAX_EXTRACTED_BYTES=209715200
SECMIND_MAX_QUESTION_BANK_BYTES=2147483648
SECMIND_MAX_QUESTION_BANK_FILES=50000
SECMIND_MAX_QUESTION_BANK_QUESTIONS=500
SECMIND_MAX_QUESTION_BANK_ARCHIVE_DEPTH=5
SECMIND_QUESTION_BANK_SCAN_BATCH_SIZE=80
SECMIND_QUESTION_BANK_CLASSIFICATION_BATCH_SIZE=8
SECMIND_QUESTION_BANK_BOUNDARY_CONFIDENCE=0.65
SECMIND_QUESTION_BANK_TYPE_CONFIDENCE=0.60
SECMIND_QUESTION_BANK_MODEL_TIMEOUT_SECONDS=120
